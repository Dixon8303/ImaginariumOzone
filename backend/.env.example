ANTHROPIC_API_KEY=sk-ant-...
COMFYUI_BASE_URL=http://localhost:8188
OUTPUT_BASE_DIR=./backend/outputs
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
YOUTUBE_CLIENT_SECRETS=/Users/YOUR_USERNAME/.config/bgf/client_secrets.json
YOUTUBE_TOKEN_CACHE=/Users/YOUR_USERNAME/.config/bgf/token.json
YOUTUBE_CHANNEL_ID=UC_IKlYsCAAA0iLGA-lQTLWA
DATABASE_PATH=./backend/bgf.db

# ── Model tier routing (BGF Orchestration Spec) ────────────────────────────
# No overrides needed — model IDs are baked into config.py.
# These optional vars let you swap tiers per-env if needed:
# MODEL_FABLE=claude-fable-5
# MODEL_OPUS=claude-opus-4-8
# MODEL_SONNET=claude-sonnet-4-6
# MODEL_HAIKU=claude-haiku-4-5-20251001

# ── Ollama (local, $0 marginal cost) ──────────────────────────────────────
# Install: https://ollama.com · then: ollama pull mistral
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ── ElevenLabs (P5 voiceover — optional, falls back to macOS say) ─────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ── vidIQ (real YouTube data — optional, all features degrade gracefully) ─
# Key from vidiq.com → account settings → API
VIDIQ_API_KEY=
VIDIQ_BASE_URL=https://api.vidiq.com
# Your channel ID for War Room analytics pull (youtube.com/account_advanced)
YOUTUBE_CHANNEL_ID=
