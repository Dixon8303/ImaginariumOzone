# CinemaWin backend configuration.
# Copy to .env and fill in. This file must never contain a real key.

# ── LLM provider ────────────────────────────────────────────────────────────
# CinemaWin works with any of these. Several are FREE with no credit card.
# Pick ONE: set the provider and paste its key.
#
#   gemini      Google Gemini      FREE tier    https://aistudio.google.com/apikey
#   groq        Groq               FREE tier    https://console.groq.com/keys
#   openrouter  OpenRouter         has :free models  https://openrouter.ai/keys
#   cerebras    Cerebras           FREE tier    https://cloud.cerebras.ai/
#   ollama      Ollama (local)     FREE, no key https://ollama.com/download
#   anthropic   Anthropic (Claude) paid         https://console.anthropic.com/settings/keys
#   openai      OpenAI             paid         https://platform.openai.com/api-keys
#   together    Together AI        paid         https://api.together.ai/settings/api-keys
#
# Free-tier providers are rate limited (Gemini ~10 requests/min, Groq ~30/min).
# CinemaWin makes one request per button press, so that is plenty for one user.
CINEMAWIN_LLM_PROVIDER=gemini
CINEMAWIN_LLM_API_KEY=

# Shortcut: instead of the two lines above you may just set the provider's own
# key variable and CinemaWin infers the provider from it.
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# Optional overrides. Leave blank to use the provider's default model.
CINEMAWIN_MODEL_CRAFT=
CINEMAWIN_MODEL_JUDGE=
CINEMAWIN_LLM_BASE_URL=
CINEMAWIN_LLM_MAX_TOKENS=8000
CINEMAWIN_LLM_TIMEOUT_SEC=180

# Anthropic only: retry on another Claude model if a request is declined.
CINEMAWIN_REFUSAL_FALLBACKS=1

# ── Demo mode ───────────────────────────────────────────────────────────────
# 1    = always return canned sample output (no key needed, nothing is charged)
# auto = canned output only when no provider is configured
# 0    = real calls only; functions return 503 if no provider is configured
CINEMAWIN_DEMO_MODE=0

# ── Server ──────────────────────────────────────────────────────────────────
CINEMAWIN_PORT=8002
CINEMAWIN_DATABASE_PATH=./cinemawin.db
CINEMAWIN_DEFAULT_PLAN=entry
CINEMAWIN_DEVELOP_RATE_LIMIT=10

# Set this so logins survive a restart. Any long random string.
# Generate one: python3 -c "import secrets; print(secrets.token_hex(32))"
CINEMAWIN_SECRET_KEY=

# Where the browser reaches the frontend. Used to build password-reset links.
CINEMAWIN_PUBLIC_URL=http://localhost:5174

# Who may call this API. Use * when the frontend is hosted elsewhere
# (GitHub Pages), or a comma-separated list of exact origins.
CINEMAWIN_CORS_ORIGINS=http://localhost:5174

# ── Email (optional) ────────────────────────────────────────────────────────
# Leave SMTP_HOST blank and accounts are verified instantly, with password
# reset links printed to the server console instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
