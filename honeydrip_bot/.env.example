# Copy this file to honeydrip_bot/.env and fill in your Alpaca Paper Trading credentials.
# NEVER commit actual keys to git. The .env file is gitignored.
#
# Get paper trading keys at: https://app.alpaca.markets (toggle to Paper)

APCA_API_KEY_ID=your_paper_key_here
APCA_API_SECRET_KEY=your_paper_secret_here

# Set this to YES only when running in a confirmed paper trading environment.
# The engine will abort immediately if this is missing or set to anything other than YES.
HONEYDRIP_ARMED=YES
